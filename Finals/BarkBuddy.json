    {
      "parameters": {
        "jsCode": "// 1. Grab the text output\nconst geminiText = $input.first().json.candidates[0].content.parts[0].text;\n\n// 2. Parse the text\nlet isBarking = false;\ntry {\n  const cleanText = geminiText.replace(/```json|```/g, '').trim();\n  const parsedData = JSON.parse(cleanText);\n  isBarking = parsedData.barking;\n} catch (e) {\n  isBarking = false;\n}\n\n// 3. Access Workflow Memory\nconst staticData = $getWorkflowStaticData('global');\n\nif (!staticData.barkHistory) {\n  staticData.barkHistory = [];\n}\n\n// 4. Update History\nstaticData.barkHistory.push(isBarking);\n\n// -------------------------------------------------------\n// NEW LOGIC: Batch & Reset\n// -------------------------------------------------------\n\nlet decision = null;\nlet shouldContinue = null;\nlet displayScore = staticData.barkHistory.filter(val => val === true).length + \"/\" + staticData.barkHistory.length;\nlet outputHistory = [...staticData.barkHistory]; // Copy current history to show in output\n\n// Only trigger decision if we have collected exactly 10 items\nif (staticData.barkHistory.length >= 10) {\n  \n  // A. Calculate Result\n  const yesCount = staticData.barkHistory.filter(val => val === true).length;\n  const thresholdMet = yesCount >= 7;\n  \n  // B. Set Output Variables\n  decision = thresholdMet ? \"YES\" : \"NO\";\n  shouldContinue = thresholdMet;\n  displayScore = yesCount + \"/10 (Batch Complete)\";\n  \n  // C. RESET STORAGE (Empty the array for the next new batch)\n  staticData.barkHistory = []; \n}\n\n// 5. Return Output\nreturn [\n  {\n    json: {\n      decision: decision,           // Will be null until full\n      shouldContinue: shouldContinue, // Will be null until full\n      status: decision ? \"BATCH COMPLETE\" : \"COLLECTING DATA\",\n      score: displayScore,\n      latestReading: isBarking,\n      history: outputHistory        // Shows the list (e.g., 10 items when full)\n    }\n  }\n];"
      },
