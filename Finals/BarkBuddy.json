    {
      "parameters": {
        "jsCode": "// 1. Grab the text output from Gemini\nconst geminiText = $input.first().json.candidates[0].content.parts[0].text;\n\n// 2. Parse the text for env_alert\nlet isTempAlert = false;\ntry {\n  const cleanText = geminiText.replace(/```json|```/g, '').trim();\n  const parsedData = JSON.parse(cleanText);\n  // Default to false if env_alert is missing\n  isTempAlert = parsedData.env_alert === true; \n} catch (e) {\n  isTempAlert = false;\n}\n\n// 3. Access Workflow Memory\nconst staticData = $getWorkflowStaticData('global');\n\n// Use tempHistory (Critical: different variable name than barking)\nif (!staticData.tempHistory) {\n  staticData.tempHistory = [];\n}\n\n// 4. Update History\nstaticData.tempHistory.push(isTempAlert);\n\n// -------------------------------------------------------\n// NEW LOGIC: Batch & Reset\n// -------------------------------------------------------\n\nlet decision = null;\nlet shouldContinue = null;\nlet displayScore = staticData.tempHistory.filter(val => val === true).length + \"/\" + staticData.tempHistory.length;\nlet outputHistory = [...staticData.tempHistory]; // Copy for display\n\n// Only trigger decision if we have collected exactly 10 items\nif (staticData.tempHistory.length >= 10) {\n\n  // A. Calculate Result\n  const yesCount = staticData.tempHistory.filter(val => val === true).length;\n  const thresholdMet = yesCount >= 7;\n\n  // B. Set Output Variables\n  decision = thresholdMet ? \"YES\" : \"NO\";\n  shouldContinue = thresholdMet;\n  displayScore = yesCount + \"/10 (Batch Complete)\";\n\n  // C. RESET STORAGE (Empty the array for the next new batch)\n  staticData.tempHistory = [];\n}\n\n// 5. Return Output\nreturn [\n  {\n    json: {\n      decision: decision,           // Will be null until full\n      shouldContinue: shouldContinue, // Will be null until full\n      alertType: \"Temperature/Humidity\",\n      status: decision ? \"BATCH COMPLETE\" : \"COLLECTING DATA\",\n      score: displayScore,\n      latestReading: isTempAlert,\n      history: outputHistory\n    }\n  }\n];"
      },
